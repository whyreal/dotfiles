#!/usr/bin/env fish

set -x ANTHROPIC_BASE_URL             https://open.bigmodel.cn/api/anthropic
set -x ANTHROPIC_AUTH_TOKEN           40c9465a035d47cebceed658e0f3617e.f6XytX7L2N0IaPUw

# 1. 默认主模型
set -x ANTHROPIC_MODEL                glm-4.7-flash

# 2. 原Opus档位对应的模型（原本Claude最高档模型，这里替换成DeepSeek）
set -x ANTHROPIC_DEFAULT_OPUS_MODEL   glm-4.7-flash

# 3. 原Sonnet中档模型
set -x ANTHROPIC_DEFAULT_SONNET_MODEL glm-4.7-flash

# 4. 原Haiku轻量快速模型
set -x ANTHROPIC_DEFAULT_HAIKU_MODEL  glm-4.7-flash
# Haiku极速轻量档位：用 deepseek-v4-flash 极速版，速度快、成本低

# 5. 代码子智能体专用模型
set -x CLAUDE_CODE_SUBAGENT_MODEL     glm-4.7-flash
# 代码执行、工具调用、子Agent任务，统一使用极速flash模型

claude
