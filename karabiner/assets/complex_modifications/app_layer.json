{
	"title": "app layer",
	"rules":[
		{
			"description": "make space as trigger",
			"manipulators": [
				{
					"type": "basic",
					"from": {
                        "key_code": "spacebar",
                         "modifiers": { "optional": ["any"] }
                    },
					"to": [ { "set_variable": {
                        "name": "app_mode",
                        "value": 1,
                        "key_up_value": 0
                    } } ],
					"to_if_alone": [ { "key_code": "spacebar" } ]
				}
			]
		},
		{
			"description": "APP layer: Fn+[hjkl] to Left, Down, Up, Right",
			"manipulators": [
				{
					"conditions": [
						{
							"type": "variable_if",
							"name": "app_mode",
							"value": 1
						}
					],
					"from": {
						"key_code": "h",
						"modifiers": {
							"optional": [
								"any"
							]
						}
					},
					"to": [
						{
							"key_code": "left_arrow", "repeat": true
						}
					],
					"type": "basic"
				},
				{
					"conditions": [
						{
							"name": "app_mode",
							"type": "variable_if",
							"value": 1
						}
					],
