								"any"
							]
						}
					},
					"to": [
						{
							"key_code": "up_arrow", "repeat": true
						}
					],
					"type": "basic"
				},
				{
					"conditions": [
						{
							"name": "app_mode",
							"type": "variable_if",
							"value": 1
						}
					],
					"from": {
						"key_code": "l",
						"modifiers": {
							"optional": [
								"any"
							]
						}
					},
					"to": [
						{
							"key_code": "right_arrow", "repeat": true
						}
					],
					"type": "basic"
				}
			]
		},
